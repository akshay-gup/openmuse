[Unit]
Description=OpenCode server for Hive (opencode serve)
After=network.target

[Service]
Type=simple
User=hive
WorkingDirectory=/opt/hive
# Shared env file: OPENCODE_SERVER_PASSWORD enables Basic auth (username
# "opencode"); provider keys (OPENAI_API_KEY, ...) configure models.
EnvironmentFile=/etc/hive/hive.env
ExecStart=/usr/local/bin/opencode serve --port 4096 --log-level INFO
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
