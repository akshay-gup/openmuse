[Unit]
Description=Hive API (single-process server + web UI)
After=network.target hive-opencode.service
Wants=hive-opencode.service

[Service]
Type=simple
User=hive
WorkingDirectory=/opt/hive
EnvironmentFile=/etc/hive/hive.env
ExecStart=/usr/bin/node /opt/hive/dist/apps/server/src/index.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
# On boot the API healthchecks `opencode serve` and fails loud if it is
# unreachable; Restart=on-failure retries until the opencode unit is up.

[Install]
WantedBy=multi-user.target
